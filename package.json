{
  "name": "twinpdf-personal-craft",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "TwinPDF: personal bilingual lecture workspace with local-folder memory and always-on AI Assist.",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs server/index.ts",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/vite/bin/vite.js build",
    "preview": "set NODE_ENV=production&& node ./node_modules/tsx/dist/cli.mjs server/index.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "smoke:real-pdf": "node ./node_modules/tsx/dist/cli.mjs scripts/smoke-playwright.ts",
    "start": "npm run dev"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
